VITE_SITE_URL=https://www.seudominio.com.br
VITE_PHONE_DISPLAY=(85) 99999-9999
VITE_PHONE_NUMBER=+5585999999999
VITE_WHATSAPP_NUMBER=5585999999999
VITE_CONTACT_EMAIL=contato@seudominio.com.br
VITE_CMS_URL=https://cms.seudominio.com.br
VITE_GTM_ID=
VITE_GA_MEASUREMENT_ID=

# Segredo compartilhado com o WordPress para registrar os leads do
# formulário de orçamento. Precisa ser idêntico ao VSB_LEADS_TOKEN definido
# no deploy/cms/.env do CMS. Gere com: openssl rand -hex 32
# Sem prefixo VITE_: é um segredo e não pode ir para o navegador.
VSB_LEADS_TOKEN=

# YouTube Data API v3: somente servidor, sem prefixo VITE_.
YOUTUBE_API_KEY=
# Playlists públicas do próprio canal. Vazio = uploads sem classificação.
# Não usar a playlist automática de uploads para classificar Shorts/vídeos completos.
YOUTUBE_SHORTS_PLAYLIST_ID=
YOUTUBE_VIDEOS_PLAYLIST_ID=
# Em desenvolvimento, pode usar ./.cache/youtube/videos-v2.json.
YOUTUBE_CACHE_FILE=/app/data/youtube/videos-v2.json
